<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Unattended-install description for the veraPDF IzPack installer, used by
  .github/workflows/ci.yml.  The suite's `ua` case validates with veraPDF and
  fails hard when it is missing (it is the only authoritative oracle for
  PDF/UA), so CI has to install it.

  Only the CLI pack is selected: the GUI pack is ~16 MB of Swing that nothing
  here uses.  Pack names and indices, and the panel class names below, are
  those the 1.30.2 installer actually declares.  Do not take them from the
  published documentation, which still calls the CLI pack "veraPDF Mac and
  *nix Scripts": that name no longer matches anything and is ignored in
  silence, leaving an install with no verapdf binary in it.
-->
<AutomatedInstallation langpack="eng">
  <com.izforge.izpack.panels.htmlhello.HTMLHelloPanel id="welcome"/>
  <com.izforge.izpack.panels.target.TargetPanel id="install_dir">
    <installpath>/opt/verapdf</installpath>
  </com.izforge.izpack.panels.target.TargetPanel>
  <com.izforge.izpack.panels.packs.PacksPanel id="sdk_pack_select">
    <pack index="0" name="veraPDF GUI" selected="false"/>
    <pack index="1" name="veraPDF CLI" selected="true"/>
    <pack index="2" name="veraPDF Documentation" selected="false"/>
    <pack index="3" name="veraPDF Sample Plugins" selected="false"/>
  </com.izforge.izpack.panels.packs.PacksPanel>
  <com.izforge.izpack.panels.install.InstallPanel id="install"/>
  <com.izforge.izpack.panels.finish.FinishPanel id="finish"/>
</AutomatedInstallation>
